{
  "name": "nutritrack",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "complexity": "eslint --config eslint.complexity.config.js .",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "api:types": "openapi-typescript $EXPO_PUBLIC_API_URL/swagger/v1/swagger.json -o src/api/schema.ts",
    "test:pact": "jest --runInBand --testPathPattern pact",
    "pact:publish": "pact-broker publish ./pacts --consumer-app-version=$(git rev-parse --short HEAD) --branch=$(git rev-parse --abbrev-ref HEAD)"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@react-native-community/netinfo": "11.3.1",
    "@react-native-community/slider": "4.5.2",
    "@tanstack/react-query": "^5.51.0",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.32.0",
    "expo": "~51.0.0",
    "expo-camera": "~15.0.0",
    "expo-crypto": "~13.0.0",
    "expo-font": "~12.0.0",
    "expo-haptics": "~13.0.0",
    "expo-image-manipulator": "~12.0.0",
    "expo-router": "~3.5.0",
    "expo-secure-store": "~13.0.0",
    "expo-sqlite": "~14.0.0",
    "expo-status-bar": "~1.12.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.0",
    "react-native-reanimated": "~3.10.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@pact-foundation/pact": "^17.1.2",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.79",
    "drizzle-kit": "^0.23.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "openapi-typescript": "^7.3.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.2.0",
    "typescript": "~5.3.3",
    "typescript-eslint": "^8.67.0"
  }
}
