{
  "consumer": {
    "name": "nutritrack-app"
  },
  "interactions": [
    {
      "description": "Einstellungen laden",
      "providerStates": [
        {
          "name": "Nutzer hat Einstellungen"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/preferences"
      },
      "response": {
        "body": {
          "language": "de",
          "theme": "Dark"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.language": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "de|en"
                }
              ]
            },
            "$.theme": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "Dark|Light"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "Makro-Verteilung speichern",
      "providerStates": [
        {
          "name": "Nutzer hat ein Tagesziel von 2150 kcal"
        }
      ],
      "request": {
        "body": {
          "macros": {
            "carbs": {
              "percent": 40
            },
            "fat": {
              "percent": 30
            },
            "protein": {
              "percent": 30
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.macros.carbs.percent": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.macros.fat.percent": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.macros.protein.percent": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "method": "PUT",
        "path": "/api/v1/goals"
      },
      "response": {
        "body": {
          "dailyKcal": 2150,
          "energyStandard": "Physiological",
          "includeActivityInGoal": false,
          "macros": {
            "carbs": {
              "grams": 215,
              "kcal": 882,
              "percent": 40
            },
            "fat": {
              "grams": 72,
              "kcal": 670,
              "percent": 30
            },
            "protein": {
              "grams": 161,
              "kcal": 661,
              "percent": 30
            }
          },
          "rounding": "Up"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.dailyKcal": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.energyStandard": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "Physiological|Declaration"
                }
              ]
            },
            "$.includeActivityInGoal": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.macros.carbs.grams": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.macros.carbs.kcal": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.macros.carbs.percent": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.macros.fat.grams": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.macros.fat.kcal": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.macros.fat.percent": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.macros.protein.grams": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.macros.protein.kcal": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.macros.protein.percent": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.rounding": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "Up|Down"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
