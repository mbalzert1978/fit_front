{
  "consumer": {
    "name": "nutritrack-app"
  },
  "interactions": [
    {
      "description": "Freigaben laden",
      "providerStates": [
        {
          "name": "Nutzer hat keine Gesundheitsquelle verbunden"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/health/consent"
      },
      "response": {
        "body": {
          "connected": false,
          "exportNutrition": false,
          "importActivity": false
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.connected": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.exportNutrition": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.importActivity": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.2"
    },
    "pactRust": {
      "ffi": "0.5.6",
      "models": "1.3.14"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "nutritrack-health"
  }
}